{
  "local_dir": "C:\\path\\to\\your\\local\\project",
  "remote_dir": "\\\\192.168.x.x\\SharedFolder",
  "use_hash_comparison": true,
  "auto_backup": false,
  "ignore_patterns": [
    "*.egg-info",
    "*.pyc",
    "*.pyo",
    ".DS_Store",
    ".env",
    ".git",
    ".gitignore",
    ".hg",
    ".idea",
    ".mypy_cache",
    ".pytest_cache",
    ".sass-cache",
    ".svn",
    ".tox",
    ".venv",
    ".vs",
    ".vscode",
    "Thumbs.db",
    "__pycache__",
    "__pypackages__",
    "build",
    "dist",
    "node_modules",
    "venv"
  ],
  "deploy_method": "smb",
  "ssh_host": "",
  "ssh_port": 22,
  "ssh_user": "",
  "ssh_key_path": "",
  "ssh_remote_dir": "",
  "ssh_password": "",

  "server": {
    "app_port": 8080,
    "app_entry": "app:app",
    "waitress_threads": 4,
    "waitress_max_body_size": 52428800,
    "task_name": "StartWaitress",
    "use_nginx": true,
    "nginx_reload_cmd": "nginx -s reload",
    "nginx_start_cmd": "start nginx"
  },

  "backup": {
    "enabled": true,
    "backup_dir": "C:\\Backups\\Database",
    "backup_nas_dir": "\\\\nas-server\\backups",
    "mysqldump_path": "C:\\Program Files\\MariaDB\\bin\\mysqldump.exe",
    "db_user": "root",
    "db_password": "your_db_password_here",
    "retention_days": 30
  },

  "all_ignore_patterns": [
    ".git",
    "__pycache__",
    "node_modules",
    ".venv",
    "venv",
    ".idea",
    ".vscode",
    ".vs",
    ".env",
    ".mypy_cache",
    ".pytest_cache",
    ".tox",
    "dist",
    "build",
    "*.egg-info",
    ".sass-cache",
    ".DS_Store",
    "Thumbs.db",
    ".svn",
    ".hg",
    "*.pyc",
    "*.pyo",
    "__pypackages__"
  ],
  "language": "en"
}
